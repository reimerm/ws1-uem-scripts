# Generated reports (JSON/XML) — written wherever a script's -OutputPath points,
# or its own folder by default. Curated examples live in a script's own
# sample-output/ folder, which is explicitly un-ignored below.
VppAllocationReport_*.json
VppAllocationReport_*.xml
*Report_[0-9]*.json
*Report_[0-9]*.xml
!**/sample-output/**

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# PowerShell transcripts, if ever captured locally
PowerShell_transcript.*.txt
